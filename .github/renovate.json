{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "platformAutomerge": false,
  "extends": [
    "config:recommended",
    "github>zewelor/renovate-config//presets/go"
  ],
  "packageRules": [
    {
      "description": "Keep the PostgreSQL test image on major version 18",
      "matchDatasources": ["docker"],
      "matchDepNames": ["postgres"],
      "allowedVersions": "/^18$/"
    }
  ]
}
